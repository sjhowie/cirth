{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleEditor",
  "version": "0.1.0",
  "identifier": "com.simpleeditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SimpleEditor",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Steve Howie",
    "shortDescription": "A lightweight text editor",
    "longDescription": "SimpleEditor is a fast, lightweight desktop text editor with syntax highlighting, markdown preview, project search and large-file support.",
    "copyright": "Copyright (c) 2026 Steve Howie",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/explorer-menu.wxs"],
        "componentRefs": ["ExplorerContextMenu"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
