{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cirth",
  "version": "../package.json",
  "identifier": "io.github.sjhowie.cirth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cirth",
        "width": 1280,
        "height": 800,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Steve Howie",
    "shortDescription": "A lightweight text editor",
    "longDescription": "Cirth is a fast, lightweight desktop text editor with syntax highlighting, markdown preview, project search and large-file support.",
    "copyright": "Copyright (c) 2026 Steve Howie",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/explorer-menu.wxs"],
        "componentRefs": ["ExplorerContextMenu"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/sjhowie/cirth/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
