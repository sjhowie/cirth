{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cirth",
  "version": "../package.json",
  "identifier": "io.github.sjhowie.cirth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cirth",
        "width": 1280,
        "height": 800,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Steve Howie",
    "shortDescription": "A lightweight text editor",
    "longDescription": "Cirth is a fast, lightweight desktop text editor with syntax highlighting, markdown preview, project search and large-file support.",
    "copyright": "Copyright (c) 2026 Steve Howie",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQTg4NjEwRkQyREM4NkYKUldSdnlDMzlFSWFvV3NNOTRVNGhtOEJwQ2tLKzRZUVhmVDd2WmxIVS8xYmRqV3pnT05BcjF3T08K",
      "endpoints": ["https://github.com/sjhowie/cirth/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
